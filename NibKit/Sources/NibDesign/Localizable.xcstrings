    "Docked %@. Capture %lld pt (top +%lld), meniscus reaches at %lld pt, fuses at %lld pt, pinches at %lld pt." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ angedockt. Erfassung %lld pt (oben +%lld), Meniskus reicht bei %lld pt, verschmilzt bei %lld pt, schnürt ab bei %lld pt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ acoplado. Captura %lld pt (arriba +%lld), el menisco llega a %lld pt, se fusiona a %lld pt, se estrecha a %lld pt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ancré. Capture %lld pt (haut +%lld), le ménisque atteint %lld pt, fusionne à %lld pt, se resserre à %lld pt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ agganciato. Cattura %lld pt (sopra +%lld), il menisco arriva a %lld pt, si fonde a %lld pt, si stringe a %lld pt."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@をドッキングしました。捕捉%lld pt（上+%lld）、メニスカス到達%lld pt、融合%lld pt、分離%lld pt。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 도킹됨. 캡처 %lldpt(위 +%lld), 메니스커스 도달 %lldpt, 융합 %lldpt, 분리 %lldpt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ gekoppeld. Vangst %lld pt (boven +%lld), meniscus reikt tot %lld pt, versmelt bij %lld pt, knijpt af bij %lld pt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadokowano %@. Przechwycenie %lld pkt (góra +%lld), menisk sięga przy %lld pkt, łączy się przy %lld pkt, zwęża się przy %lld pkt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ acoplado. Captura %lld pt (topo +%lld), menisco alcança em %lld pt, funde em %lld pt, estreita em %lld pt."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ закреплен. Захват %lld пт (сверху +%lld), мениск достигает %lld пт, сливается при %lld пт, сужается при %lld пт."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dockad. Fångst %lld pt (topp +%lld), menisken når vid %lld pt, smälter samman vid %lld pt, snörps av vid %lld pt."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ yerleştirildi. Yakalama %lld pt (üst +%lld), menisküs %lld pt’de ulaşır, %lld pt’de birleşir, %lld pt’de ayrılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已停靠%@。捕获 %lld 磅（顶部 +%lld），弯液面在 %lld 磅处接触，在 %lld 磅处融合，在 %lld 磅处分离。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已停駐%@。擷取 %lld 點（頂部 +%lld），彎液面在 %lld 點處接觸，在 %lld 點處融合，在 %lld 點處分離。"
          }
        }
      }
    },
