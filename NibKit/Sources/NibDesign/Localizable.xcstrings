    "Press and hold a notebook, then drag it. Hold it over another cover's centre to combine." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege den Finger auf ein Notizbuch und ziehe es. Halte es über die Mitte eines anderen Umschlags, um beide zusammenzufassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado un cuaderno y arrástralo. Sostenlo sobre el centro de otra portada para combinarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le doigt sur un carnet, puis faites-le glisser. Maintenez-le au centre d’une autre couverture pour les combiner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca e tieni premuto un quaderno, poi trascinalo. Tienilo sopra il centro di un’altra copertina per unirli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノートを長押ししてドラッグします。別の表紙の中央に重ねると結合します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노트를 길게 누른 다음 드래그하십시오. 다른 표지의 중앙 위에 두면 합쳐집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je vinger op een notitieboek en sleep het. Houd het boven het midden van een andere omslag om ze samen te voegen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotknij notatnika i przytrzymaj, a następnie go przeciągnij. Przytrzymaj go nad środkiem innej okładki, aby je połączyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque e mantenha pressionado um caderno e arraste-o. Segure-o sobre o centro de outra capa para combiná-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь блокнота и удерживайте, затем перетащите его. Удерживайте над центром другой обложки, чтобы объединить их."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll fingret på en anteckningsbok och dra den. Håll den över mitten av ett annat omslag för att slå ihop dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir deftere dokunup basılı tutun, ardından sürükleyin. Birleştirmek için başka bir kapağın ortasının üzerinde tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住笔记本，然后拖动。将其悬停在另一个封面的中央即可合并。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住筆記本，然後拖移。將其懸停在另一個封面的中央即可合併。"
          }
        }
      }
    },
