    "Your notes are inside Nib, so reinstalling the app deletes them. Move them to a folder from Cloud & Backup." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Notizen liegen in Nib, daher löscht eine Neuinstallation der App sie. Bewege sie über „Cloud & Backup“ in einen Ordner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus notas están dentro de Nib, así que reinstalar la app las elimina. Muévelas a una carpeta desde Nube y copia de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos notes se trouvent dans Nib : réinstaller l’app les supprime. Déplacez-les vers un dossier depuis Cloud et sauvegarde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue note sono all’interno di Nib, quindi reinstallare l’app le elimina. Spostale in una cartella da Cloud e backup."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノートはNib内に保存されているため、Appを再インストールすると削除されます。「クラウドとバックアップ」からフォルダに移動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노트가 Nib 내부에 있으므로 앱을 다시 설치하면 삭제됩니다. 클라우드 및 백업에서 폴더로 이동하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je notities staan in Nib, dus als je de app opnieuw installeert, worden ze verwijderd. Verplaats ze naar een map via Cloud en reservekopie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje notatki są wewnątrz Nib, więc ponowna instalacja aplikacji je usunie. Przenieś je do folderu w sekcji Chmura i kopia zapasowa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas notas estão dentro do Nib, então reinstalar o app as apaga. Mova-as para uma pasta em Nuvem e Backup."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши заметки хранятся внутри Nib, поэтому при переустановке приложения они удалятся. Переместите их в папку в разделе «Облако и резервное копирование»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina anteckningar finns i Nib, så om appen installeras om raderas de. Flytta dem till en mapp under Moln och säkerhetskopiering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notlarınız Nib’in içinde olduğundan uygulamayı yeniden yüklemek onları siler. Onları Bulut ve Yedekleme’den bir klasöre taşıyın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的笔记存放在 Nib 内部，因此重新安装 App 会将其删除。请在“云端和备份”中将其移到文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的筆記存放在 Nib 內部，因此重新安裝 App 會將其刪除。請在「雲端和備份」中將其移到檔案夾。"
          }
        }
      }
    },
