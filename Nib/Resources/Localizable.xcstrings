            "value" : "%lld件の変更を元に戻しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변경 사항 %lld개를 되돌렸습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld wijzigingen teruggedraaid."
          }
        },
        "pl" : {
          "variations" : {
            "plural" : {
              "few" : {
