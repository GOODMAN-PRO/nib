        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的筆記會保留在 Nib 內部，移除或重新安裝 App 會將其刪除。你可以稍後在「雲端和備份」中選擇檔案夾。"
          }
        }
