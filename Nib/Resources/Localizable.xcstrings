    "Revert undoes one step, even after later edits. Anything changed since is kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zurücksetzen“ macht einen Schritt rückgängig, auch nach späteren Änderungen. Alles, was seitdem geändert wurde, bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revertir deshace un paso, incluso tras ediciones posteriores. Se conserva todo lo que haya cambiado después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rétablir annule une étape, même après des modifications ultérieures. Tout ce qui a changé depuis est conservé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina annulla un passaggio, anche dopo modifiche successive. Tutto ciò che è cambiato da allora viene mantenuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「元に戻す」は、その後に編集があっても1ステップを取り消します。その後に変更されたものは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "되돌리기는 이후에 편집한 경우에도 한 단계를 실행 취소합니다. 이후에 변경된 내용은 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terugdraaien maakt één stap ongedaan, zelfs na latere wijzigingen. Alles wat sindsdien is gewijzigd, blijft behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywróć cofa jeden krok, nawet po późniejszych edycjach. Wszystko, co zmieniono później, zostaje zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reverter desfaz uma etapa, mesmo após edições posteriores. Tudo o que foi alterado depois é mantido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Вернуть» отменяет один шаг, даже после более поздних правок. Все, что изменилось с тех пор, сохраняется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återställ ångrar ett steg, även efter senare ändringar. Allt som ändrats sedan dess behålls."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geri Döndür, sonraki düzenlemelerden sonra bile bir adımı geri alır. O zamandan beri değişen her şey korunur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“还原”会撤销一个步骤，即使之后有其他编辑。此后更改的内容会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「復原」會還原一個步驟，即使之後有其他編輯。之後更改的內容會保留。"
          }
        }
      }
    },
    "Reverted %lld changes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Änderungen zurückgesetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se han revertido %lld cambios."
          }
