    "Nib reads the calendars on this device, including Google, Outlook and Exchange accounts added in the Settings app. Events stay on this device." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nib liest die Kalender auf diesem Gerät, einschließlich Google-, Outlook- und Exchange-Accounts, die in der App „Einstellungen“ hinzugefügt wurden. Ereignisse bleiben auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nib lee los calendarios de este dispositivo, incluidas las cuentas de Google, Outlook y Exchange añadidas en la app Ajustes. Los eventos permanecen en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
