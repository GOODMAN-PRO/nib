          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nib legge i calendari di questo dispositivo, inclusi gli account Google, Outlook ed Exchange aggiunti nell’app Impostazioni. Gli eventi restano su questo dispositivo."
