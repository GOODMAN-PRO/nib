    "Every change an agent makes waits until you allow it on this iPad." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Änderung eines Agenten wartet, bis du sie auf diesem iPad erlaubst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada cambio que haga un agente espera hasta que lo permitas en este iPad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque modification d’un agent attend votre autorisation sur cet iPad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni modifica di un agente attende finché non la consenti su questo iPad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントによる変更はすべて、このiPadで許可するまで待機します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "에이전트가 만드는 모든 변경 사항은 이 iPad에서 허용할 때까지 대기합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke wijziging van een agent wacht totdat je die op deze iPad toestaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każda zmiana agenta czeka, aż zezwolisz na nią na tym iPadzie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda alteração feita por um agente aguarda até você permiti-la neste iPad."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждое изменение агента ждет, пока вы не разрешите его на этом iPad."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje ändring som en agent gör väntar tills du tillåter den på den här iPaden."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir aracının yaptığı her değişiklik, bu iPad’de izin verene kadar bekler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代理所做的每项更改都会等待你在此 iPad 上允许。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代理程式所做的每項更改都會等待你在此 iPad 上允許。"
          }
        }
      }
    },
    "Every client that uses the current token is refused until you paste the new one." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Client, der das aktuelle Token verwendet, wird abgewiesen, bis du das neue einfügst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los clientes que usen el token actual se rechazarán hasta que pegues el nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les clients qui utilisent le jeton actuel sont refusés jusqu’à ce que vous colliez le nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni client che usa il token attuale viene rifiutato finché non incolli quello nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のトークンを使っているクライアントは、新しいトークンを貼り付けるまですべて拒否されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 토큰을 사용하는 모든 클라이언트는 새 토큰을 붙여넣을 때까지 거부됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke client die het huidige token gebruikt, wordt geweigerd totdat je het nieuwe plakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy klient używający obecnego tokenu będzie odrzucany, dopóki nie wkleisz nowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os clientes que usam o token atual são recusados até você colar o novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все клиенты, использующие текущий токен, будут отклоняться, пока вы не вставите новый."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla klienter som använder den nuvarande token nekas tills du klistrar in den nya."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli belirteci kullanan her istemci, yenisini yapıştırana kadar reddedilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有使用当前令牌的客户端都将被拒绝，直到你粘贴新令牌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有使用目前權杖的用戶端都會遭拒絕，直到你貼上新權杖。"
          }
        }
      }
    },
    "Every element in this collection is removed on every device. Pages keep the copies already inserted." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Element dieser Sammlung wird auf allen Geräten entfernt. Seiten behalten die bereits eingefügten Kopien."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los elementos de esta colección se eliminan en todos los dispositivos. Las páginas conservan las copias ya insertadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque élément de cette collection est supprimé sur tous les appareils. Les pages conservent les copies déjà insérées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
