    "Documents already locked with the password that is still syncing will open with the new one instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokumente, die bereits mit dem noch synchronisierenden Passwort gesperrt sind, öffnen sich stattdessen mit dem neuen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los documentos ya bloqueados con la contraseña que aún se está sincronizando se abrirán con la nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les documents déjà verrouillés avec le mot de passe en cours de synchronisation s’ouvriront avec le nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I documenti già bloccati con la password ancora in sincronizzazione si apriranno invece con quella nuova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期中のパスワードですでにロックされている書類は、代わりに新しいパスワードで開けるようになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 동기화 중인 암호로 이미 잠긴 문서는 대신 새 암호로 열립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Documenten die al zijn vergrendeld met het wachtwoord dat nog wordt gesynchroniseerd, openen in plaats daarvan met het nieuwe."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokumenty już zablokowane hasłem, które jest nadal synchronizowane, otworzą się zamiast tego nowym hasłem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Documentos já bloqueados com a senha que ainda está sincronizando abrirão com a nova."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Документы, уже заблокированные паролем, который еще синхронизируется, будут открываться новым паролем."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokument som redan är låsta med lösenordet som fortfarande synkroniseras öppnas med det nya i stället."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hâlâ eşzamanlanan parolayla zaten kilitlenmiş belgeler bunun yerine yeni parolayla açılır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已使用仍在同步的密码锁定的文稿，将改为使用新密码打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已使用仍在同步的密碼鎖定的文件，將改為使用新密碼打開。"
          }
        }
      }
    },
