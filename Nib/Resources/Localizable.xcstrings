    "That folder is inside Nib, so reinstalling the app would delete it. Choose one outside Nib." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Ordner liegt in Nib, daher würde eine Neuinstallation der App ihn löschen. Wähle einen Ordner außerhalb von Nib."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa carpeta está dentro de Nib, así que reinstalar la app la eliminaría. Elige una fuera de Nib."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce dossier se trouve dans Nib : réinstaller l’app le supprimerait. Choisissez-en un en dehors de Nib."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quella cartella è all’interno di Nib, quindi reinstallare l’app la eliminerebbe. Scegline una fuori da Nib."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのフォルダはNib内にあるため、Appを再インストールすると削除されます。Nibの外にあるフォルダを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 폴더는 Nib 내부에 있으므로 앱을 다시 설치하면 삭제됩니다. Nib 외부의 폴더를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die map staat in Nib, dus als je de app opnieuw installeert, wordt ze verwijderd. Kies een map buiten Nib."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten folder jest wewnątrz Nib, więc ponowna instalacja aplikacji by go usunęła. Wybierz folder poza Nib."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essa pasta está dentro do Nib, então reinstalar o app a apagaria. Escolha uma fora do Nib."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта папка находится внутри Nib, поэтому при переустановке приложения она удалится. Выберите папку вне Nib."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den mappen finns i Nib, så den skulle raderas om appen installerades om. Välj en mapp utanför Nib."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu klasör Nib’in içinde olduğundan uygulamayı yeniden yüklemek onu siler. Nib’in dışında bir klasör seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该文件夹位于 Nib 内部，重新安装 App 会将其删除。请选择 Nib 之外的文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該檔案夾位於 Nib 內部，重新安裝 App 會將其刪除。請選擇 Nib 之外的檔案夾。"
          }
        }
      }
    },
