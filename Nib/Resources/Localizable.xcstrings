          "stringUnit" : {
            "state" : "translated",
            "value" : "Başlıklar / veya : içeremez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标题不能包含 / 或 :。"
