          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em um marcador de comentário na página, ou toque e mantenha pressionada a página e escolha Adicionar Comentário."
          }
        },
        "ru" : {
          "stringUnit" : {
