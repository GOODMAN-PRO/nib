    "iOS pauses the bridge when the screen locks or you leave Nib. While the bridge is on, this stops the screen from locking." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS pausiert die Bridge, wenn der Bildschirm gesperrt wird oder du Nib verlässt. Solange die Bridge eingeschaltet ist, verhindert dies die Bildschirmsperre."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS pone en pausa el puente cuando la pantalla se bloquea o sales de Nib. Mientras el puente está activado, esto evita que la pantalla se bloquee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS met la passerelle en pause lorsque l’écran se verrouille ou que vous quittez Nib. Tant que la passerelle est activée, cette option empêche le verrouillage de l’écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS mette in pausa il bridge quando lo schermo si blocca o esci da Nib. Mentre il bridge è attivo, questa opzione impedisce il blocco dello schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面がロックされるかNibを離れると、iOSはブリッジを一時停止します。ブリッジがオンの間は、画面がロックされないようにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면이 잠기거나 Nib을 떠나면 iOS가 브리지를 일시 정지합니다. 브리지가 켜져 있는 동안 화면이 잠기지 않게 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS pauzeert de bridge wanneer het scherm vergrendelt of je Nib verlaat. Zolang de bridge aanstaat, voorkomt dit dat het scherm vergrendelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS wstrzymuje mostek, gdy ekran się zablokuje lub opuścisz Nib. Gdy mostek jest włączony, ta opcja zapobiega blokowaniu ekranu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iOS pausa a ponte quando a tela é bloqueada ou você sai do Nib. Enquanto a ponte estiver ativada, isto impede que a tela seja bloqueada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS приостанавливает мост, когда экран блокируется или вы выходите из Nib. Пока мост включен, эта настройка не дает экрану заблокироваться."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS pausar bryggan när skärmen låses eller du lämnar Nib. Medan bryggan är på förhindrar detta att skärmen låses."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran kilitlendiğinde veya Nib’den çıktığınızda iOS köprüyü duraklatır. Köprü açıkken bu, ekranın kilitlenmesini önler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏幕锁定或离开 Nib 时，iOS 会暂停桥接。桥接打开期间，此选项会阻止屏幕锁定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "螢幕鎖定或離開 Nib 時，iOS 會暫停橋接。橋接開啟期間，此選項會防止螢幕鎖定。"
          }
        }
      }
    },
    "iPhone doesn't work with Apple Pencil. Choose Any Input to write with your finger." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das iPhone unterstützt den Apple Pencil nicht. Wähle „Jede Eingabe“, um mit dem Finger zu schreiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El iPhone no funciona con el Apple Pencil. Elige Cualquier entrada para escribir con el dedo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’iPhone ne fonctionne pas avec l’Apple Pencil. Choisissez Toute saisie pour écrire avec le doigt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone non funziona con Apple Pencil. Scegli Qualsiasi input per scrivere con il dito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneはApple Pencilに対応していません。指で書くには「すべての入力」を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone은 Apple Pencil을 지원하지 않습니다. 손가락으로 쓰려면 모든 입력을 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone werkt niet met de Apple Pencil. Kies 'Elke invoer' om met je vinger te schrijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone nie obsługuje Apple Pencil. Wybierz Dowolne wprowadzanie, aby pisać palcem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O iPhone não funciona com o Apple Pencil. Escolha Qualquer Entrada para escrever com o dedo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone не поддерживает Apple Pencil. Выберите «Любой ввод», чтобы писать пальцем."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone fungerar inte med Apple Pencil. Välj All inmatning för att skriva med fingret."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone, Apple Pencil ile çalışmaz. Parmağınızla yazmak için Her Giriş’i seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
