    "People using an older Nib can view this document but can't edit it until they update." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personen mit einem älteren Nib können dieses Dokument ansehen, aber erst nach einer Aktualisierung bearbeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las personas con una versión antigua de Nib pueden ver este documento, pero no editarlo hasta que actualicen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les personnes utilisant une ancienne version de Nib peuvent afficher ce document, mais pas le modifier avant leur mise à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le persone che usano una versione precedente di Nib possono visualizzare questo documento, ma non modificarlo finché non eseguono l’aggiornamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古いNibを使っている人はこの書類を閲覧できますが、アップデートするまで編集はできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 버전의 Nib을 사용하는 사람은 이 문서를 볼 수 있지만 업데이트할 때까지 편집할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensen met een oudere Nib kunnen dit document bekijken, maar pas wijzigen nadat ze hebben bijgewerkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoby używające starszej wersji Nib mogą wyświetlać ten dokument, ale nie mogą go edytować, dopóki nie uaktualnią aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pessoas com uma versão antiga do Nib podem visualizar este documento, mas não podem editá-lo até atualizarem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Люди со старой версией Nib могут просматривать этот документ, но не смогут редактировать его, пока не обновят приложение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personer som använder en äldre Nib kan visa dokumentet men inte redigera det förrän de uppdaterar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
