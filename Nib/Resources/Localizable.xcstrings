    "Shown after three wrong entries. Anyone holding this device can read it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird nach drei falschen Eingaben angezeigt. Jeder, der dieses Gerät in der Hand hält, kann ihn lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra tras tres intentos incorrectos. Cualquiera que tenga este dispositivo puede leerla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiché après trois saisies erronées. Toute personne ayant cet appareil en main peut le lire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrato dopo tre inserimenti errati. Chiunque abbia in mano questo dispositivo può leggerlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3回間違えると表示されます。このデバイスを持っている人は誰でも読むことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세 번 잘못 입력하면 표시됩니다. 이 기기를 가진 누구나 읽을 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt getoond na drie verkeerde pogingen. Iedereen die dit apparaat vasthoudt, kan het lezen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetlana po trzech błędnych próbach. Każdy, kto trzyma to urządzenie, może ją przeczytać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrada após três tentativas incorretas. Qualquer pessoa com este dispositivo pode lê-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывается после трех неверных попыток. Ее может прочитать любой, у кого в руках это устройство."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visas efter tre felaktiga försök. Alla som håller i den här enheten kan läsa den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üç yanlış girişten sonra gösterilir. Bu aygıtı elinde tutan herkes okuyabilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输错三次后显示。任何拿着此设备的人都能看到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入錯誤三次後顯示。任何拿著此裝置的人都能讀取。"
          }
        }
      }
    },
    "Shown on the sticky notes and comments you add, and to people you collaborate with." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird auf deinen Haftnotizen und Kommentaren angezeigt und für Personen, mit denen du zusammenarbeitest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra en las notas adhesivas y los comentarios que añades, y a las personas con las que colaboras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiché sur les notes adhésives et commentaires que vous ajoutez, et aux personnes avec qui vous collaborez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrato sulle note adesive e sui commenti che aggiungi e alle persone con cui collabori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加した付箋やコメントに表示され、共同作業する相手にも表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추가하는 스티커 메모와 댓글에 표시되며 함께 협업하는 사람에게도 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Getoond op plaknotities en opmerkingen die je toevoegt, en aan mensen met wie je samenwerkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetlana na dodawanych karteczkach i komentarzach oraz osobom, z którymi współpracujesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostrado nas notas adesivas e comentários que você adiciona e às pessoas com quem você colabora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывается на добавленных вами стикерах и комментариях, а также людям, с которыми вы работаете вместе."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
