    "Sync stops and the password is removed from this device. Files on the server and in the library stay as they are." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Synchronisierung stoppt, und das Passwort wird von diesem Gerät entfernt. Dateien auf dem Server und in der Bibliothek bleiben unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización se detiene y la contraseña se elimina de este dispositivo. Los archivos del servidor y de la biblioteca se quedan como están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation s’arrête et le mot de passe est supprimé de cet appareil. Les fichiers du serveur et de la bibliothèque restent tels quels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione si interrompe e la password viene rimossa da questo dispositivo. I file sul server e nella libreria restano invariati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期が停止し、パスワードがこのデバイスから削除されます。サーバとライブラリのファイルはそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화가 중단되고 이 기기에서 암호가 제거됩니다. 서버와 라이브러리의 파일은 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De synchronisatie stopt en het wachtwoord wordt van dit apparaat verwijderd. Bestanden op de server en in de bibliotheek blijven zoals ze zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizacja się zatrzyma, a hasło zostanie usunięte z tego urządzenia. Pliki na serwerze i w bibliotece pozostaną bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização para e a senha é removida deste dispositivo. Os arquivos no servidor e na biblioteca permanecem como estão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация прекратится, а пароль будет удален с этого устройства. Файлы на сервере и в библиотеке останутся как есть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniseringen stoppas och lösenordet tas bort från den här enheten. Filer på servern och i biblioteket förblir som de är."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eşzamanlama durur ve parola bu aygıttan kaldırılır. Sunucudaki ve kitaplıktaki dosyalar olduğu gibi kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步会停止，密码会从此设备中移除。服务器上和资料库中的文件保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步會停止，密碼會從此裝置中移除。伺服器上和資料庫中的檔案保持不變。"
          }
        }
      }
    },
