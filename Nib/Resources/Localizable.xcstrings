    "Moved objects snap to the lines and squares of the page template." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegte Objekte rasten an den Linien und Kästchen der Seitenvorlage ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los objetos movidos se ajustan a las líneas y cuadros de la plantilla de la página."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les objets déplacés s’alignent sur les lignes et les carreaux du modèle de page."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli oggetti spostati si agganciano alle linee e ai quadretti del modello di pagina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
