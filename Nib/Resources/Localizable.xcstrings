    "Only allow untrusted certificates for a server you run yourself (a self-signed certificate)." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube nicht vertrauenswürdige Zertifikate nur für einen Server, den du selbst betreibst (ein selbstsigniertes Zertifikat)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite certificados no fiables solo para un servidor que gestiones tú (un certificado autofirmado)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’autorisez les certificats non fiables que pour un serveur que vous gérez vous-même (certificat autosigné)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti certificati non attendibili solo per un server che gestisci tu (un certificato autofirmato)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信頼されていない証明書は、自分で運用しているサーバ（自己署名証明書）に対してのみ許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "신뢰할 수 없는 인증서는 직접 운영하는 서버(자체 서명된 인증서)에만 허용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sta niet-vertrouwde certificaten alleen toe voor een server die je zelf beheert (een zelfondertekend certificaat)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwalaj na niezaufane certyfikaty tylko dla serwera, którym sam zarządzasz (certyfikat z podpisem własnym)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita certificados não confiáveis apenas para um servidor que você mesmo gerencia (um certificado autoassinado)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешайте недоверенные сертификаты только для сервера, которым управляете сами (самоподписанный сертификат)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tillåt bara ej betrodda certifikat för en server du själv driver (ett självsignerat certifikat)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güvenilmeyen sertifikalara yalnızca kendi çalıştırdığınız bir sunucu için izin verin (kendinden imzalı bir sertifika)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅对你自己运行的服务器（自签名证书）允许不受信任的证书。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只對你自己執行的伺服器（自我簽署憑證）允許不受信任的憑證。"
          }
        }
      }
    },
