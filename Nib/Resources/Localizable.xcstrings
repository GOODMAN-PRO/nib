        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套索始终排在第一位。隐藏的工具在“更多”中轻点即可使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
