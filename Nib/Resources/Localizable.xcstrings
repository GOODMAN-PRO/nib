    "Your library opens next. Everything you write is saved as you go." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Nächstes öffnet sich deine Bibliothek. Alles, was du schreibst, wird laufend gesichert."
