    "What you add to the page is listed here, with handwriting read as text." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was du der Seite hinzufügst, wird hier aufgelistet – Handschrift wird als Text gelesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
