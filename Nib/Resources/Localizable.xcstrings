    "Your copy of “%@” is locked. Remove the password lock to join the live session." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Kopie von „%@“ ist gesperrt. Entferne die Passwortsperre, um der Live-Sitzung beizutreten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu copia de “%@” está bloqueada. Elimina el bloqueo con contraseña para unirte a la sesión en directo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre copie de « %@ » est verrouillée. Supprimez le verrouillage par mot de passe pour rejoindre la session en direct."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua copia di “%@” è bloccata. Rimuovi il blocco con password per partecipare alla sessione dal vivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”のコピーはロックされています。ライブセッションに参加するには、パスワードロックを解除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’의 사본이 잠겨 있습니다. 라이브 세션에 참가하려면 암호 잠금을 제거하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kopie van '%@' is vergrendeld. Verwijder de wachtwoordvergrendeling om deel te nemen aan de livesessie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
