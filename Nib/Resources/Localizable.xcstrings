    "Line ends that land within 12 pt of another shape join it, and lines that close a loop become one polygon." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linienenden, die weniger als 12 pt von einer anderen Form entfernt enden, werden mit ihr verbunden, und Linien, die eine Schleife schließen, werden zu einem Polygon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los extremos de línea que quedan a menos de 12 pt de otra forma se unen a ella, y las líneas que cierran un bucle se convierten en un polígono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les extrémités de ligne situées à moins de 12 pt d’une autre forme s’y rattachent, et les lignes qui ferment une boucle deviennent un polygone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le estremità delle linee che finiscono entro 12 pt da un’altra forma si uniscono a essa e le linee che chiudono un anello diventano un poligono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別の図形から12 pt以内で終わる線の端はその図形につながり、ループを閉じる線は1つの多角形になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 도형에서 12pt 이내에 끝나는 선의 끝은 해당 도형에 연결되며, 고리를 닫는 선은 하나의 다각형이 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lijnuiteinden die binnen 12 pt van een andere vorm eindigen, worden ermee verbonden, en lijnen die een lus sluiten, worden één veelhoek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Końce linii kończące się w odległości do 12 pkt od innego kształtu łączą się z nim, a linie zamykające pętlę stają się jednym wielokątem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pontas de linha que terminam a até 12 pt de outra forma se unem a ela, e linhas que fecham um laço viram um polígono."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Концы линий, оказавшиеся ближе 12 пт к другой фигуре, присоединяются к ней, а линии, замыкающие контур, становятся одним многоугольником."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linjeändar som hamnar inom 12 pt från en annan form kopplas ihop med den, och linjer som sluter en slinga blir en polygon."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir şekle 12 pt yakınında biten çizgi uçları ona birleşir ve bir döngüyü kapatan çizgiler tek bir çokgen olur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "线条端点落在其他形状 12 磅以内时会与其相连，闭合成环的线条会变成一个多边形。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "線條端點落在其他形狀 12 點以內時會與其相連，閉合成環的線條會變成一個多邊形。"
          }
        }
      }
    },
