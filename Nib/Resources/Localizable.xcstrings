        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrivez avec l’Apple Pencil. Les doigts font défiler, zoomer et sélectionner : une main posée ne laisse donc jamais de trace."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi con Apple Pencil. Le dita scorrono, ingrandiscono e selezionano, così una mano appoggiata non lascia mai segni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Pencilで書きましょう。指ではスクロール、ズーム、選択ができるので、手を置いても跡が付きません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Pencil로 쓰십시오. 손가락으로는 스크롤, 확대/축소 및 선택을 하므로 손을 올려놓아도 자국이 남지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijf met de Apple Pencil. Met je vingers scrol, zoom en selecteer je, zodat een rustende hand nooit een streep achterlaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pisz za pomocą Apple Pencil. Palce przewijają, powiększają i zaznaczają, więc oparta dłoń nigdy nie zostawia śladu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva com o Apple Pencil. Os dedos rolam, ampliam e selecionam, então uma mão apoiada nunca deixa marcas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пишите с помощью Apple Pencil. Пальцами можно прокручивать, масштабировать и выбирать, поэтому лежащая на экране рука никогда не оставляет следов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv med Apple Pencil. Fingrar rullar, zoomar och markerar, så en vilande hand lämnar aldrig några märken."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Pencil ile yazın. Parmaklar kaydırır, büyütür ve seçer; böylece dayanan bir el asla iz bırakmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Apple Pencil 书写。手指用于滚动、缩放和选择，因此搁在屏幕上的手不会留下痕迹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Apple Pencil 書寫。手指用來捲動、縮放和選取，因此擱在螢幕上的手不會留下痕跡。"
          }
        }
      }
    },
    "Write with your finger or any stylus. Scroll and zoom with two fingers." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibe mit dem Finger oder einem beliebigen Stift. Scrolle und zoome mit zwei Fingern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe con el dedo o con cualquier lápiz óptico. Desplázate y amplía con dos dedos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écrivez avec le doigt ou n’importe quel stylet. Faites défiler et zoomez avec deux doigts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi con il dito o con qualsiasi stilo. Scorri e ingrandisci con due dita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指や任意のスタイラスで書きましょう。2本指でスクロールやズームができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손가락이나 스타일러스로 쓰십시오. 두 손가락으로 스크롤하고 확대/축소하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schrijf met je vinger of een willekeurige stylus. Scrol en zoom met twee vingers."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pisz palcem lub dowolnym rysikiem. Przewijaj i powiększaj dwoma palcami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreva com o dedo ou qualquer caneta stylus. Role e amplie com dois dedos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пишите пальцем или любым стилусом. Прокручивайте и масштабируйте двумя пальцами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv med fingret eller valfri styluspenna. Rulla och zooma med två fingrar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parmağınızla veya herhangi bir kalemle yazın. İki parmakla kaydırın ve büyütün."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用手指或任意触控笔书写。用两指滚动和缩放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用手指或任何觸控筆書寫。用兩指捲動和縮放。"
          }
        }
      }
    },
