    "“%@”" : {
      "extractionState" : "manual",
      "shouldTranslate" : false
    },
    "“%@” is live. Leave that session to share this document." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist live. Verlasse diese Sitzung, um dieses Dokument zu teilen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” está en directo. Sal de esa sesión para compartir este documento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est en direct. Quittez cette session pour partager ce document."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” è dal vivo. Lascia quella sessione per condividere questo documento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”はライブ中です。この書類を共有するには、そのセッションから退出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’이(가) 라이브 중입니다. 이 문서를 공유하려면 해당 세션에서 나가십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' is live. Verlaat die sessie om dit document te delen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” jest na żywo. Opuść tę sesję, aby udostępnić ten dokument."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” está ao vivo. Saia dessa sessão para compartilhar este documento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» уже в совместном сеансе. Выйдите из этого сеанса, чтобы открыть общий доступ к этому документу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”%@” är live. Lämna den sessionen för att dela det här dokumentet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” canlı. Bu belgeyi paylaşmak için o oturumdan ayrılın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”正在实时共享。请离开该会话以共享此文稿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」正在即時共享。請離開該工作階段以共享此文件。"
          }
        }
      }
    },
    "“%@” is locked, but this library's password hasn't reached this device yet. Wait for it to sync, or set a new password to replace it on every device." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist gesperrt, aber das Passwort dieser Bibliothek ist noch nicht auf diesem Gerät angekommen. Warte auf die Synchronisierung oder lege ein neues Passwort fest, das es auf allen Geräten ersetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” está bloqueado, pero la contraseña de esta biblioteca aún no ha llegado a este dispositivo. Espera a que se sincronice o define una contraseña nueva para reemplazarla en todos los dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est verrouillé, mais le mot de passe de cette bibliothèque n’est pas encore arrivé sur cet appareil. Attendez la synchronisation, ou définissez un nouveau mot de passe pour le remplacer sur tous les appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” è bloccato, ma la password di questa libreria non è ancora arrivata su questo dispositivo. Attendi la sincronizzazione oppure imposta una nuova password per sostituirla su tutti i dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”はロックされていますが、このライブラリのパスワードがまだこのデバイスに届いていません。同期されるまで待つか、新しいパスワードを設定してすべてのデバイスで置き換えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’은(는) 잠겨 있지만 이 라이브러리의 암호가 아직 이 기기에 도착하지 않았습니다. 동기화될 때까지 기다리거나 새 암호를 설정하여 모든 기기에서 교체하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' is vergrendeld, maar het wachtwoord van deze bibliotheek is nog niet op dit apparaat aangekomen. Wacht tot het is gesynchroniseerd, of stel een nieuw wachtwoord in dat het op elk apparaat vervangt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” jest zablokowany, ale hasło tej biblioteki nie dotarło jeszcze na to urządzenie. Zaczekaj na synchronizację lub ustaw nowe hasło, aby zastąpić je na każdym urządzeniu."
          }
