    "Nib follows the Light, Dark or Automatic setting in Settings › Display & Brightness." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nib folgt der Einstellung „Hell“, „Dunkel“ oder „Automatisch“ unter „Einstellungen“ › „Anzeige & Helligkeit“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nib sigue el ajuste Claro, Oscuro o Automático de Ajustes › Pantalla y brillo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nib suit le réglage Clair, Sombre ou Automatique de Réglages › Luminosité et affichage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nib segue l’impostazione Chiaro, Scuro o Automatico in Impostazioni › Schermo e luminosità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nibは「設定」›「画面表示と明るさ」の「ライト」「ダーク」「自動」の設定に従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nib은 설정 › 디스플레이 및 밝기의 라이트, 다크 또는 자동 설정을 따릅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nib volgt de instelling Licht, Donker of Automatisch in Instellingen › Scherm en helderheid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nib stosuje ustawienie Jasny, Ciemny lub Automatycznie z sekcji Ustawienia › Ekran i jasność."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Nib segue o ajuste Claro, Escuro ou Automático em Ajustes › Tela e Brilho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nib следует настройке «Светлое», «Темное» или «Автоматически» в разделе «Настройки» › «Экран и яркость»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nib följer inställningen Ljust, Mörkt eller Automatiskt i Inställningar › Skärm och ljusstyrka."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nib, Ayarlar › Ekran ve Parlaklık bölümündeki Açık, Koyu veya Otomatik ayarını izler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nib 会遵循“设置”›“显示与亮度”中的“浅色”“深色”或“自动”设置。"
          }
        },
        "zh-Hant" : {
