        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute une forme identique reliée à celle-ci. Faites-la glisser vers une autre forme pour les connecter."
          }
        },
        "it" : {
          "stringUnit" : {
