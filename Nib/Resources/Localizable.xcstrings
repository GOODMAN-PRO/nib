    "Only Apple Pencil draws. Fingers scroll, zoom and select." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur der Apple Pencil zeichnet. Finger scrollen, zoomen und wählen aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo dibuja el Apple Pencil. Los dedos desplazan, amplían y seleccionan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seul l’Apple Pencil dessine. Les doigts font défiler, zoomer et sélectionner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegna solo Apple Pencil. Le dita scorrono, ingrandiscono e selezionano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Pencilだけで描けます。指ではスクロール、ズーム、選択ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Pencil로만 그릴 수 있습니다. 손가락으로는 스크롤, 확대/축소 및 선택을 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen de Apple Pencil tekent. Met vingers scrol, zoom en selecteer je."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rysuje tylko Apple Pencil. Palce przewijają, powiększają i zaznaczają."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas o Apple Pencil desenha. Os dedos rolam, ampliam e selecionam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рисует только Apple Pencil. Пальцами можно прокручивать, масштабировать и выбирать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast Apple Pencil ritar. Fingrar rullar, zoomar och markerar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca Apple Pencil çizer. Parmaklar kaydırır, büyütür ve seçer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅 Apple Pencil 可以绘图。手指用于滚动、缩放和选择。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有 Apple Pencil 可以繪圖。手指用於捲動、縮放和選取。"
          }
        }
      }
    },
    "Only Apple Pencil writes. Fingers scroll, zoom and select." : {
