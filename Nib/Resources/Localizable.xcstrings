    "Stop it and save the session to your history, or keep it while you work elsewhere." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppe ihn und sichere die Sitzung in deinem Verlauf, oder behalte ihn, während du woanders arbeitest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detenlo y guarda la sesión en tu historial, o consérvalo mientras trabajas en otro sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêtez-le et enregistrez la session dans votre historique, ou gardez-le pendant que vous travaillez ailleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrompilo e salva la sessione nella cronologia, oppure mantienilo mentre lavori altrove."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止してセッションを履歴に保存するか、ほかの作業中も続けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중단하고 세션을 기록에 저장하거나, 다른 곳에서 작업하는 동안 유지하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop hem en bewaar de sessie in je geschiedenis, of houd hem aan terwijl je ergens anders werkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatrzymaj go i zachowaj sesję w historii lub zostaw go, gdy pracujesz gdzie indziej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pare e salve a sessão no seu histórico, ou mantenha-a enquanto trabalha em outro lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остановите его и сохраните сеанс в истории или оставьте, пока работаете в другом месте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppa den och spara sessionen i historiken, eller behåll den medan du arbetar någon annanstans."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durdurup oturumu geçmişinize kaydedin veya başka bir yerde çalışırken devam ettirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止并将此时段存储到历史记录中，或在你处理其他事情时保留它。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止並將此時段儲存到歷史記錄中，或在你處理其他事情時保留它。"
          }
        }
      }
    },
    "Stopped looking for the live session." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
