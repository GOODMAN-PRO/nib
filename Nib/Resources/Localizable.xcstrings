    "Calm keeps the water but halves the stretch. Off uses solid chrome and no motion." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ruhig“ behält das Wasser, halbiert aber die Dehnung. „Aus“ verwendet deckende Bedienelemente ohne Bewegung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sereno mantiene el agua pero reduce el estiramiento a la mitad. No usa controles opacos y sin movimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calme conserve l’eau mais réduit l’étirement de moitié. Désactivé utilise des commandes opaques et aucune animation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calmo mantiene l’acqua ma dimezza l’allungamento. Disattivo usa controlli opachi e nessun movimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「穏やか」は水の動きを保ちながら伸びを半分にします。「オフ」は不透明なコントロールを使い、動きをなくします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "차분하게는 물의 움직임을 유지하되 늘어남을 절반으로 줄입니다. 끔은 불투명한 컨트롤을 사용하고 움직임이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rustig behoudt het water maar halveert het uitrekken. Uit gebruikt ondoorzichtige regelaars zonder beweging."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spokojny zachowuje wodę, ale o połowę zmniejsza rozciąganie. Wył. używa nieprzezroczystych narzędzi i wyłącza ruch."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calmo mantém a água, mas reduz o estiramento pela metade. Desativado usa controles sólidos e nenhum movimento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Спокойный» сохраняет воду, но вдвое уменьшает растяжение. «Выкл.» использует непрозрачные элементы управления без движения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lugn behåller vattnet men halverar töjningen. Av använder heltäckande reglage och ingen rörelse."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sakin, suyu korur ancak esnemeyi yarıya indirir. Kapalı, opak denetimler kullanır ve hareket içermez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“平静”保留水的效果，但拉伸减半。“关闭”使用不透明控件且没有动态效果。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「平靜」保留水的效果，但拉伸減半。「關閉」使用不透明的控制項且沒有動態效果。"
          }
        }
      }
    },
