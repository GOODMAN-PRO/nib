    "Another app may be using it. Close that app, then try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möglicherweise verwendet eine andere App sie. Schließe diese App und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que otra app la esté usando. Cierra esa app e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre app l’utilise peut-être. Fermez cette app, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrebbe essere in uso da un’altra app. Chiudi quell’app, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかのAppが使用している可能性があります。そのAppを閉じてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱에서 사용 중일 수 있습니다. 해당 앱을 닫은 다음 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Misschien gebruikt een andere app hem. Sluit die app en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Może używać go inna aplikacja. Zamknij ją i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro app pode estar usando a câmera. Feche esse app e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возможно, ее использует другое приложение. Закройте его и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annan app kanske använder den. Stäng den appen och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir uygulama kullanıyor olabilir. O uygulamayı kapatıp yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能有其他 App 正在使用它。请关闭该 App 后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可能有其他 App 正在使用。請關閉該 App 後再試一次。"
          }
        }
      }
    },
    "Another live session is running. Leave it before joining this one." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere Live-Sitzung läuft. Verlasse sie, bevor du dieser beitrittst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay otra sesión en directo en curso. Sal de ella antes de unirte a esta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre session en direct est en cours. Quittez-la avant de rejoindre celle-ci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È in corso un’altra sessione dal vivo. Lasciala prima di partecipare a questa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のライブセッションが実行中です。このセッションに参加する前に退出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 라이브 세션이 진행 중입니다. 이 세션에 참가하기 전에 해당 세션에서 나가십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is een andere livesessie actief. Verlaat die voordat je aan deze deelneemt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trwa inna sesja na żywo. Opuść ją przed dołączeniem do tej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outra sessão ao vivo está em andamento. Saia dela antes de entrar nesta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Идет другой совместный сеанс. Выйдите из него, прежде чем присоединиться к этому."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annan livesession pågår. Lämna den innan du ansluter till den här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir canlı oturum çalışıyor. Buna katılmadan önce ondan ayrılın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一个实时会话正在进行。请先离开它再加入此会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一個即時工作階段正在進行。請先離開再加入此工作階段。"
          }
        }
      }
    },
