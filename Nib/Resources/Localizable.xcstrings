    "Use the actions to move, resize or rotate it, or send it to another page." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende die Aktionen, um es zu bewegen, zu skalieren, zu drehen oder auf eine andere Seite zu senden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa las acciones para moverlo, redimensionarlo, girarlo o enviarlo a otra página."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez les actions pour le déplacer, le redimensionner, le faire pivoter ou l’envoyer vers une autre page."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa le azioni per spostarlo, ridimensionarlo, ruotarlo o inviarlo a un’altra pagina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクションを使って、移動、サイズ変更、回転、または別のページへの送信ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동작을 사용하여 이동, 크기 조절, 회전하거나 다른 페이지로 보내십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik de acties om het te verplaatsen, vergroten of verkleinen, draaien of naar een andere pagina te sturen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj czynności, aby go przenieść, zmienić rozmiar, obrócić lub wysłać na inną stronę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use as ações para movê-lo, redimensioná-lo, girá-lo ou enviá-lo para outra página."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте действия, чтобы переместить его, изменить размер, повернуть или отправить на другую страницу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
