          "stringUnit" : {
            "state" : "translated",
            "value" : "已连接的代理届时可以在你查看之前更改和删除笔记。你仍然可以撤销它们的更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
