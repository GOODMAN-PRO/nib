    "Unlocked documents lock again 2 minutes after you leave Nib, and as soon as you lock your %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entsperrte Dokumente werden 2 Minuten nach dem Verlassen von Nib wieder gesperrt – und sofort, wenn du dein %@ sperrst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los documentos desbloqueados se vuelven a bloquear 2 minutos después de salir de Nib, y en cuanto bloqueas tu %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les documents déverrouillés se verrouillent à nouveau 2 minutes après que vous quittez Nib, et dès que vous verrouillez votre %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I documenti sbloccati si bloccano di nuovo 2 minuti dopo che esci da Nib e appena blocchi il tuo %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロックを解除した書類は、Nibを離れてから2分後、または%@をロックした時点で再びロックされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금 해제된 문서는 Nib을 떠나고 2분 후, 그리고 %@을(를) 잠그는 즉시 다시 잠깁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ontgrendelde documenten worden 2 minuten nadat je Nib verlaat weer vergrendeld, en zodra je je %@ vergrendelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odblokowane dokumenty blokują się ponownie 2 minuty po opuszczeniu Nib oraz od razu po zablokowaniu urządzenia (%@)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Documentos desbloqueados são bloqueados novamente 2 minutos depois que você sai do Nib e assim que você bloqueia seu %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разблокированные документы снова блокируются через 2 минуты после выхода из Nib, а также сразу, как только вы заблокируете %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upplåsta dokument låses igen 2 minuter efter att du lämnat Nib, och så fort du låser din %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilidi açılan belgeler, Nib’den ayrıldıktan 2 dakika sonra ve %@ aygıtınızı kilitlediğiniz anda yeniden kilitlenir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已解锁的文稿会在你离开 Nib 2 分钟后，以及你锁定%@时立即重新锁定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已解鎖的文件會在你離開 Nib 2 分鐘後，以及你鎖定%@時立即重新鎖定。"
          }
        }
      }
    },
