          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша копия «%@» заблокирована. Снимите блокировку паролем, чтобы присоединиться к совместному сеансу."
          }
        },
        "sv" : {
          "stringUnit" : {
