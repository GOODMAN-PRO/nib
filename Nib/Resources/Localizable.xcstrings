    "Star notebooks and folders, or bookmark pages, to keep them here." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere Notizbücher und Ordner mit einem Stern oder setze Lesezeichen auf Seiten, um sie hier zu behalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca cuadernos y carpetas con una estrella, o añade marcadores a páginas, para tenerlos aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez une étoile aux carnets et dossiers, ou des signets aux pages, pour les retrouver ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi una stella a quaderni e cartelle o un segnalibro alle pagine per tenerli qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノートやフォルダにスターを付けるか、ページをブックマークすると、ここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노트와 폴더에 별표를 표시하거나 페이지에 책갈피를 추가하면 여기에 보관됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef notitieboeken en mappen een ster of maak bladwijzers voor pagina's om ze hier te bewaren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oznaczaj notatniki i foldery gwiazdką lub dodawaj zakładki do stron, aby je tu przechowywać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque cadernos e pastas com estrela, ou adicione marcadores a páginas, para mantê-los aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмечайте блокноты и папки звездочкой или добавляйте страницы в закладки, чтобы они были здесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stjärnmärk anteckningsböcker och mappar, eller bokmärk sidor, för att ha dem här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada tutmak için defterleri ve klasörleri yıldızlayın veya sayfalara yer işareti koyun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为笔记本和文件夹加星标，或为页面添加书签，即可将它们保留在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為筆記本和檔案夾加上星號，或為頁面加入書籤，即可將其保留在這裡。"
          }
        }
      }
    },
