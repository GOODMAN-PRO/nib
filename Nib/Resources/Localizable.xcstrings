    "New token issued. Clients that still use the old one are refused until you paste the new one." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neues Token ausgegeben. Clients, die noch das alte verwenden, werden abgewiesen, bis du das neue einfügst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha emitido un token nuevo. Los clientes que aún usen el anterior se rechazarán hasta que pegues el nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouveau jeton émis. Les clients qui utilisent encore l’ancien sont refusés jusqu’à ce que vous colliez le nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuovo token emesso. I client che usano ancora quello vecchio vengono rifiutati finché non incolli quello nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいトークンを発行しました。古いトークンを使っているクライアントは、新しいトークンを貼り付けるまで拒否されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 토큰이 발급되었습니다. 이전 토큰을 사용하는 클라이언트는 새 토큰을 붙여넣을 때까지 거부됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuw token uitgegeven. Clients die nog het oude gebruiken, worden geweigerd totdat je het nieuwe plakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wydano nowy token. Klienci, którzy nadal używają starego, będą odrzucani, dopóki nie wkleisz nowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novo token emitido. Clientes que ainda usam o antigo são recusados até você colar o novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выпущен новый токен. Клиенты, которые еще используют старый, будут отклоняться, пока вы не вставите новый."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ny token har utfärdats. Klienter som fortfarande använder den gamla nekas tills du klistrar in den nya."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni belirteç verildi. Eskisini kullanmaya devam eden istemciler, yenisini yapıştırana kadar reddedilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已签发新令牌。仍在使用旧令牌的客户端将被拒绝，直到你粘贴新令牌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已發出新權杖。仍在使用舊權杖的用戶端會遭拒絕，直到你貼上新權杖。"
          }
        }
      }
    },
