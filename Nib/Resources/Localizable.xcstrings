    "%@ reaches past private networks: anyone who can reach this iPad from there could try tokens against the bridge." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reicht über private Netzwerke hinaus: Jeder, der dieses iPad von dort erreicht, könnte Tokens an der Bridge ausprobieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ va más allá de las redes privadas: cualquiera que pueda llegar a este iPad desde ahí podría probar tokens contra el puente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ s’étend au-delà des réseaux privés : toute personne pouvant joindre cet iPad depuis là pourrait essayer des jetons sur la passerelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ va oltre le reti private: chiunque possa raggiungere questo iPad da lì potrebbe provare token sul bridge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はプライベートネットワークの外に届きます：そこからこのiPadにアクセスできる人は誰でも、ブリッジに対してトークンを試せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 사설 네트워크 밖까지 닿습니다. 그곳에서 이 iPad에 접근할 수 있는 누구나 브리지에 토큰을 시도할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reikt verder dan privénetwerken: iedereen die deze iPad vandaar kan bereiken, kan tokens op de bridge proberen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wykracza poza sieci prywatne: każdy, kto może stamtąd połączyć się z tym iPadem, mógłby próbować tokenów na mostku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vai além das redes privadas: qualquer pessoa que alcance este iPad a partir dali pode tentar tokens na ponte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ выходит за пределы частных сетей: любой, кто может связаться с этим iPad оттуда, сможет подбирать токены к мосту."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ når bortom privata nätverk: vem som helst som kan nå den här iPaden därifrån kan pröva token mot bryggan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ özel ağların ötesine ulaşır: Buradan bu iPad’e erişebilen herkes köprüye karşı belirteç deneyebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@超出了私有网络范围：任何能从那里访问此 iPad 的人都可能尝试用令牌访问桥接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@超出私人網路範圍：任何能從那裡連上此 iPad 的人都可能嘗試用權杖存取橋接。"
          }
        }
      }
    },
