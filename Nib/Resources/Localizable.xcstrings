    "Fingers, a mouse and other styluses draw too." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finger, eine Maus und andere Stifte zeichnen ebenfalls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dedos, un ratón y otros lápices ópticos también dibujan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les doigts, une souris et les autres stylets dessinent aussi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche le dita, un mouse e altri stili disegnano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指、マウス、ほかのスタイラスでも描けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손가락, 마우스 및 다른 스타일러스로도 그릴 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vingers, een muis en andere stylussen tekenen ook."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palce, mysz i inne rysiki również rysują."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dedos, mouse e outras canetas stylus também desenham."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пальцы, мышь и другие стилусы тоже рисуют."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fingrar, en mus och andra styluspennor ritar också."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parmaklar, fare ve diğer kalemler de çizer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手指、鼠标和其他触控笔也可以绘图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手指、滑鼠和其他觸控筆也可以繪圖。"
          }
        }
      }
    },
    "Fingers, a mouse and other styluses write too. Scroll and zoom with two fingers." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finger, eine Maus und andere Stifte schreiben ebenfalls. Scrolle und zoome mit zwei Fingern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dedos, un ratón y otros lápices ópticos también escriben. Desplázate y amplía con dos dedos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les doigts, une souris et les autres stylets écrivent aussi. Faites défiler et zoomez avec deux doigts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche le dita, un mouse e altri stili scrivono. Scorri e ingrandisci con due dita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指、マウス、ほかのスタイラスでも書けます。2本指でスクロールやズームができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손가락, 마우스 및 다른 스타일러스로도 쓸 수 있습니다. 두 손가락으로 스크롤하고 확대/축소하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vingers, een muis en andere stylussen schrijven ook. Scrol en zoom met twee vingers."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palce, mysz i inne rysiki również piszą. Przewijaj i powiększaj dwoma palcami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dedos, mouse e outras canetas stylus também escrevem. Role e amplie com dois dedos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пальцы, мышь и другие стилусы тоже пишут. Прокручивайте и масштабируйте двумя пальцами."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fingrar, en mus och andra styluspennor skriver också. Rulla och zooma med två fingrar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parmaklar, fare ve diğer kalemler de yazar. İki parmakla kaydırın ve büyütün."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手指、鼠标和其他触控笔也可以书写。用两指滚动和缩放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手指、滑鼠和其他觸控筆也可以書寫。用兩指捲動和縮放。"
          }
        }
      }
    },
