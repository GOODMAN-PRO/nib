        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nib leest de agenda's op dit apparaat, ook Google-, Outlook- en Exchange-accounts die in de Instellingen-app zijn toegevoegd. Gebeurtenissen blijven op dit apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nib odczytuje kalendarze na tym urządzeniu, w tym konta Google, Outlook i Exchange dodane w aplikacji Ustawienia. Wydarzenia pozostają na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
