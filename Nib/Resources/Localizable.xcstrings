    "Connect your own AI model in Settings to ask questions about your notes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde in den Einstellungen dein eigenes KI-Modell, um Fragen zu deinen Notizen zu stellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta tu propio modelo de IA en Ajustes para hacer preguntas sobre tus notas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez votre propre modèle d’IA dans Réglages pour poser des questions sur vos notes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega il tuo modello di IA in Impostazioni per fare domande sulle tue note."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」で自分のAIモデルを接続すると、ノートについて質問できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 자신의 AI 모델을 연결하여 노트에 대해 질문하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbind je eigen AI-model in Instellingen om vragen te stellen over je notities."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
