    "This board is full, so writing on it is paused. Add a board, or erase items or move them to another board." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Tafel ist voll, daher ist das Schreiben darauf pausiert. Füge eine Tafel hinzu oder radiere Objekte bzw. bewege sie auf eine andere Tafel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este tablero está lleno, así que la escritura está en pausa. Añade un tablero, o borra ítems o muévelos a otro tablero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce tableau est plein : l’écriture y est donc en pause. Ajoutez un tableau, ou effacez des éléments ou déplacez-les vers un autre tableau."
          }
