    "Set a password to lock “%@”. It unlocks every locked document in this library." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege ein Passwort fest, um „%@“ zu sperren. Es entsperrt jedes gesperrte Dokument in dieser Bibliothek."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define una contraseña para bloquear “%@”. Desbloquea todos los documentos bloqueados de esta biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez un mot de passe pour verrouiller « %@ ». Il déverrouille tous les documents verrouillés de cette bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta una password per bloccare “%@”. Sblocca tutti i documenti bloccati di questa libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”をロックするパスワードを設定してください。このパスワードで、このライブラリ内のロックされたすべての書類のロックを解除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘%@’을(를) 잠글 암호를 설정하십시오. 이 암호로 이 라이브러리의 모든 잠긴 문서를 잠금 해제할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel een wachtwoord in om '%@' te vergrendelen. Het ontgrendelt elk vergrendeld document in deze bibliotheek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw hasło, aby zablokować „%@”. Odblokowuje ono każdy zablokowany dokument w tej bibliotece."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
