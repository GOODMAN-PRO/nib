    "Squeeze Apple Pencil Pro to show the Pencil palette at its tip. Needs iPadOS 17.5 or later." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke den Apple Pencil Pro, um die Stiftpalette an seiner Spitze zu zeigen. Erfordert iPadOS 17.5 oder neuer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprieta el Apple Pencil Pro para mostrar la paleta del Pencil en su punta. Requiere iPadOS 17.5 o posterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressez l’Apple Pencil Pro pour afficher la palette du Pencil à sa pointe. Nécessite iPadOS 17.5 ou version ultérieure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi Apple Pencil Pro per mostrare la tavolozza Pencil sulla punta. Richiede iPadOS 17.5 o versioni successive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Pencil Proをスクイーズすると、ペン先にPencilパレットが表示されます。iPadOS 17.5以降が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Pencil Pro를 스퀴즈하면 펜 끝에 Pencil 팔레트가 표시됩니다. iPadOS 17.5 이상이 필요합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Knijp in de Apple Pencil Pro om het Pencil-palet bij de punt te tonen. Vereist iPadOS 17.5 of nieuwer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ściśnij Apple Pencil Pro, aby pokazać paletę Pencil przy jego końcówce. Wymaga iPadOS 17.5 lub nowszego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperte o Apple Pencil Pro para mostrar a paleta do Pencil na ponta. Requer iPadOS 17.5 ou posterior."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сожмите Apple Pencil Pro, чтобы показать палитру Pencil у его кончика. Требуется iPadOS 17.5 или новее."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kläm på Apple Pencil Pro för att visa Pencil-paletten vid spetsen. Kräver iPadOS 17.5 eller senare."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ucunda Pencil paletini göstermek için Apple Pencil Pro’yu sıkın. iPadOS 17.5 veya sonrası gerekir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "捏合 Apple Pencil Pro 即可在笔尖处显示 Pencil 调板。需要 iPadOS 17.5 或更高版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "擠壓 Apple Pencil Pro 即可在筆尖處顯示 Pencil 工具盤。需要 iPadOS 17.5 以上版本。"
          }
        }
      }
    },
