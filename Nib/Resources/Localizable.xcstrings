    "Used Nib before? Choose the same folder to open your library again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du Nib schon einmal verwendet? Wähle denselben Ordner, um deine Bibliothek wieder zu öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ya has usado Nib? Elige la misma carpeta para volver a abrir tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez déjà utilisé Nib ? Choisissez le même dossier pour rouvrir votre bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai già usato Nib? Scegli la stessa cartella per riaprire la tua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前にNibを使っていましたか？同じフォルダを選択すると、ライブラリを再び開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전에 Nib을 사용했습니까? 같은 폴더를 선택하면 라이브러리를 다시 열 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heb je Nib eerder gebruikt? Kies dezelfde map om je bibliotheek weer te openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Używałeś już Nib? Wybierz ten sam folder, aby ponownie otworzyć bibliotekę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já usou o Nib? Escolha a mesma pasta para abrir sua biblioteca novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже пользовались Nib? Выберите ту же папку, чтобы снова открыть библиотеку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har du använt Nib förut? Välj samma mapp för att öppna ditt bibliotek igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nib’i daha önce kullandınız mı? Kitaplığınızı yeniden açmak için aynı klasörü seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前用过 Nib？选择同一个文件夹即可重新打开你的资料库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以前用過 Nib 嗎？選擇同一個檔案夾即可重新打開你的資料庫。"
          }
        }
      }
    },
