    "Hold Command and scroll to zoom towards the pointer. Pinch on a trackpad works too." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Befehlstaste gedrückt und scrolle, um zum Zeiger hin zu zoomen. Zusammenziehen auf einem Trackpad funktioniert auch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada la tecla Comando y desplázate para hacer zoom hacia el puntero. También funciona pellizcar en un trackpad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez la touche Commande et faites défiler pour zoomer vers le pointeur. Le pincement sur un trackpad fonctionne aussi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto Comando e scorri per ingrandire verso il puntatore. Funziona anche il pizzico sul trackpad."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commandキーを押しながらスクロールすると、ポインタに向かってズームします。トラックパッドでのピンチも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Command 키를 누른 채 스크롤하면 포인터 쪽으로 확대/축소됩니다. 트랙패드에서 핀치해도 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd Command ingedrukt en scrol om naar de aanwijzer toe te zoomen. Knijpen op een trackpad werkt ook."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj Command i przewiń, aby powiększyć w kierunku wskaźnika. Szczypanie na gładziku też działa."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha Command pressionado e role para ampliar em direção ao ponteiro. Pinçar no trackpad também funciona."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте Command и прокручивайте, чтобы масштабировать к указателю. Сведение пальцев на трекпаде тоже работает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ned Kommando och rulla för att zooma mot pekaren. Nyp på en styrplatta fungerar också."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İmlece doğru büyütmek için Komut tuşunu basılı tutup kaydırın. İzleme dörtgeninde kıstırma da çalışır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 Command 键并滚动，即可朝指针方向缩放。在触控板上捏合也可以。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 Command 鍵並捲動，即可朝指標方向縮放。在觸控式軌跡板上捏合也可以。"
          }
        }
      }
    },
    "Hold Command on any screen to see what its keys do." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte auf jedem Bildschirm die Befehlstaste gedrückt, um zu sehen, was die Tasten tun."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada la tecla Comando en cualquier pantalla para ver qué hacen sus teclas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez la touche Commande enfoncée sur n’importe quel écran pour voir le rôle de ses touches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto Comando in qualsiasi schermata per vedere cosa fanno i suoi tasti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どの画面でもCommandキーを押し続けると、キーの機能を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무 화면에서나 Command 키를 길게 누르면 키의 기능을 확인할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd op elk scherm Command ingedrukt om te zien wat de toetsen doen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj Command na dowolnym ekranie, aby zobaczyć, co robią jego klawisze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha Command pressionado em qualquer tela para ver o que as teclas fazem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте Command на любом экране, чтобы увидеть, что делают клавиши."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ned Kommando på vilken skärm som helst för att se vad dess tangenter gör."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuşların ne yaptığını görmek için herhangi bir ekranda Komut tuşunu basılı tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任意屏幕上按住 Command 键即可查看各按键的功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在任何畫面上按住 Command 鍵即可查看各按鍵的功能。"
          }
        }
      }
    },
    "Hold at the end of a stroke to snap it to a shape." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte am Ende eines Strichs, um ihn an einer Form einrasten zu lassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén al final de un trazo para ajustarlo a una forma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez à la fin d’un trait pour l’ajuster à une forme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto alla fine di un tratto per agganciarlo a una forma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストロークの最後で長押しすると図形にスナップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "획의 끝에서 유지하면 도형에 맞춰집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd vast aan het einde van een streek om er een vorm van te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj na końcu linii, aby przyciągnąć ją do kształtu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha no fim de um traço para ajustá-lo a uma forma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задержите в конце штриха, чтобы привязать его к фигуре."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll kvar i slutet av ett streck för att fästa det till en form."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir şekle yapıştırmak için çizginin sonunda basılı tutun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在笔画末端按住即可将其吸附为形状。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在筆畫末端按住即可將其對齊為形狀。"
          }
        }
      }
    },
    "Hold the Pencil still at the end of a stroke to turn it into a clean shape, then move it to resize or turn the shape before you lift." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den Pencil am Ende eines Strichs still, um ihn in eine saubere Form zu verwandeln, und bewege ihn dann, um die Form vor dem Anheben zu skalieren oder zu drehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén quieto el Pencil al final de un trazo para convertirlo en una forma limpia y muévelo para cambiar su tamaño o girarla antes de levantarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le Pencil immobile à la fin d’un trait pour le transformer en forme nette, puis déplacez-le pour redimensionner ou faire pivoter la forme avant de le lever."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni fermo Pencil alla fine di un tratto per trasformarlo in una forma pulita, poi muovilo per ridimensionare o ruotare la forma prima di sollevarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストロークの最後でPencilを止めるときれいな図形に変わります。離す前に動かすと、図形のサイズ変更や回転ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "획의 끝에서 Pencil을 멈추고 있으면 깔끔한 도형으로 바뀝니다. 들어 올리기 전에 움직이면 도형의 크기를 조절하거나 회전할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de Pencil stil aan het einde van een streek om er een strakke vorm van te maken, en beweeg hem om de vorm te vergroten of te draaien voordat je optilt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj Pencil nieruchomo na końcu linii, aby zamienić ją w czysty kształt, a następnie poruszaj nim, aby zmienić rozmiar lub obrócić kształt przed uniesieniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o Pencil parado no fim de um traço para transformá-lo em uma forma limpa e mova-o para redimensionar ou girar a forma antes de levantar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задержите Pencil в конце штриха, чтобы превратить его в ровную фигуру, затем двигайте его, чтобы изменить размер фигуры или повернуть ее, прежде чем оторвать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll Pencil stilla i slutet av ett streck för att göra det till en ren form, och flytta den sedan för att ändra storlek på eller vrida formen innan du lyfter."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temiz bir şekle dönüştürmek için bir çizginin sonunda Pencil’ı sabit tutun, ardından kaldırmadan önce şekli yeniden boyutlandırmak veya döndürmek için hareket ettirin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在笔画末端按住 Pencil 不动，即可将其变成整齐的形状；抬起前移动 Pencil 可调整形状的大小或旋转形状。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在筆畫末端按住 Pencil 不動，即可將其變成整齊的形狀；抬起前移動 Pencil 可調整形狀的大小或旋轉形狀。"
          }
        }
      }
    },
