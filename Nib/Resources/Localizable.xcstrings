    "Reaches past private networks: anyone who can reach this iPad could try tokens." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reicht über private Netzwerke hinaus: Jeder, der dieses iPad erreicht, könnte Tokens ausprobieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va más allá de las redes privadas: cualquiera que pueda llegar a este iPad podría probar tokens."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’étend au-delà des réseaux privés : toute personne pouvant joindre cet iPad pourrait essayer des jetons."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va oltre le reti private: chiunque possa raggiungere questo iPad potrebbe provare dei token."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライベートネットワークの外に届きます：このiPadにアクセスできる人は誰でもトークンを試せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사설 네트워크 밖까지 닿습니다. 이 iPad에 접근할 수 있는 누구나 토큰을 시도할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reikt verder dan privénetwerken: iedereen die deze iPad kan bereiken, kan tokens proberen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykracza poza sieci prywatne: każdy, kto może połączyć się z tym iPadem, mógłby próbować tokenów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vai além das redes privadas: qualquer pessoa que alcance este iPad pode tentar tokens."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выходит за пределы частных сетей: любой, кто может связаться с этим iPad, сможет подбирать токены."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når bortom privata nätverk: vem som helst som kan nå den här iPaden kan pröva token."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özel ağların ötesine ulaşır: Bu iPad’e erişebilen herkes belirteç deneyebilir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超出了私有网络范围：任何能访问此 iPad 的人都可能尝试令牌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "超出私人網路範圍：任何能連上此 iPad 的人都可能嘗試權杖。"
          }
        }
      }
    },
