    "The lasso always comes first. Hidden tools stay one tap away in More." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Lasso steht immer an erster Stelle. Ausgeblendete Werkzeuge sind unter „Mehr“ nur einen Tipp entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El lazo siempre va primero. Las herramientas ocultas están a un toque en Más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lasso est toujours en premier. Les outils masqués restent à portée d’un toucher dans Plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
