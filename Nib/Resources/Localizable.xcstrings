    "Nextcloud, ownCloud, a NAS or any WebDAV server. The library is mirrored into the folder; the password stays in this device's Keychain." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nextcloud, ownCloud, ein NAS oder ein beliebiger WebDAV-Server. Die Bibliothek wird in den Ordner gespiegelt; das Passwort bleibt im Schlüsselbund dieses Geräts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nextcloud, ownCloud, un NAS o cualquier servidor WebDAV. La biblioteca se refleja en la carpeta; la contraseña se queda en el llavero de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nextcloud, ownCloud, un NAS ou tout serveur WebDAV. La bibliothèque est recopiée dans le dossier ; le mot de passe reste dans le trousseau de cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nextcloud, ownCloud, un NAS o qualsiasi server WebDAV. La libreria viene duplicata nella cartella; la password resta nel portachiavi di questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nextcloud、ownCloud、NAS、または任意のWebDAVサーバ。ライブラリはフォルダにミラーリングされ、パスワードはこのデバイスのキーチェーンに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nextcloud, ownCloud, NAS 또는 모든 WebDAV 서버. 라이브러리가 폴더에 미러링되며, 암호는 이 기기의 키체인에 보관됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nextcloud, ownCloud, een NAS of een andere WebDAV-server. De bibliotheek wordt naar de map gespiegeld; het wachtwoord blijft in de sleutelhanger van dit apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nextcloud, ownCloud, NAS lub dowolny serwer WebDAV. Biblioteka jest odzwierciedlana w folderze; hasło pozostaje w pęku kluczy tego urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nextcloud, ownCloud, um NAS ou qualquer servidor WebDAV. A biblioteca é espelhada na pasta; a senha fica nas Chaves deste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nextcloud, ownCloud, NAS или любой сервер WebDAV. Библиотека зеркалируется в папку; пароль остается в связке ключей этого устройства."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nextcloud, ownCloud, en NAS eller valfri WebDAV-server. Biblioteket speglas till mappen; lösenordet stannar i den här enhetens nyckelring."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nextcloud, ownCloud, bir NAS veya herhangi bir WebDAV sunucusu. Kitaplık klasöre yansıtılır; parola bu aygıtın Anahtar Zinciri’nde kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nextcloud、ownCloud、NAS 或任何 WebDAV 服务器。资料库会镜像到该文件夹；密码保留在此设备的钥匙串中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nextcloud、ownCloud、NAS 或任何 WebDAV 伺服器。資料庫會鏡像到該檔案夾；密碼會保留在此裝置的鑰匙圈中。"
          }
        }
      }
    },
