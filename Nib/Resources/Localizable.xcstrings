        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圈出影像中要保留的部分。"
          }
        }
      }
    },
    "Draw around the part to keep. With VoiceOver, choose Rectangle and a shape below." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umrande den Teil, den du behalten möchtest. Wähle mit VoiceOver unten „Rechteck“ und eine Form."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja alrededor de la parte que quieras conservar. Con VoiceOver, elige Rectángulo y una forma abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessinez autour de la partie à conserver. Avec VoiceOver, choisissez Rectangle et une forme ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disegna intorno alla parte da mantenere. Con VoiceOver, scegli Rettangolo e una forma qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残したい部分を囲むように描いてください。VoiceOverでは、下で「長方形」と図形を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유지할 부분을 둘러 그리십시오. VoiceOver를 사용하는 경우 아래에서 직사각형과 도형을 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teken om het deel dat je wilt behouden. Kies met VoiceOver hieronder 'Rechthoek' en een vorm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrysuj część, którą chcesz zachować. Z VoiceOver wybierz poniżej Prostokąt i kształt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenhe em volta da parte que deseja manter. Com o VoiceOver, escolha Retângulo e uma forma abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обведите часть, которую нужно оставить. С VoiceOver выберите ниже «Прямоугольник» и фигуру."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rita runt den del du vill behålla. Med VoiceOver väljer du Rektangel och en form nedan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutmak istediğiniz parçanın çevresini çizin. VoiceOver ile aşağıdan Dikdörtgen’i ve bir şekli seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圈出要保留的部分。使用旁白时，请在下方选取“矩形”和一个形状。"
