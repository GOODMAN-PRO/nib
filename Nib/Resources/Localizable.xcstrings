    "Shows the tip of the current tool where Apple Pencil will touch the page. Hover over a tool in the Pencil palette to see its name." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt die Spitze des aktuellen Werkzeugs dort, wo der Apple Pencil die Seite berühren wird. Bewege den Stift über ein Werkzeug in der Stiftpalette, um seinen Namen zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra la punta de la herramienta actual donde el Apple Pencil tocará la página. Pasa por encima de una herramienta de la paleta del Pencil para ver su nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche la pointe de l’outil actuel là où l’Apple Pencil touchera la page. Survolez un outil de la palette du Pencil pour voir son nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra la punta dello strumento attuale nel punto in cui Apple Pencil toccherà la pagina. Passa sopra uno strumento nella tavolozza Pencil per vederne il nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Pencilがページに触れる位置に、現在のツールの先端を表示します。Pencilパレットのツールの上にホバーすると名前が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Pencil이 페이지에 닿을 위치에 현재 도구의 끝을 보여줍니다. Pencil 팔레트의 도구 위로 호버하면 이름이 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toont de punt van het huidige gereedschap waar de Apple Pencil de pagina zal raken. Zweef boven een gereedschap in het Pencil-palet om de naam te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje końcówkę bieżącego narzędzia tam, gdzie Apple Pencil dotknie strony. Najedź na narzędzie w palecie Pencil, aby zobaczyć jego nazwę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra a ponta da ferramenta atual onde o Apple Pencil tocará a página. Passe sobre uma ferramenta na paleta do Pencil para ver o nome dela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает кончик текущего инструмента там, где Apple Pencil коснется страницы. Наведите на инструмент в палитре Pencil, чтобы увидеть его название."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visar spetsen på det aktuella verktyget där Apple Pencil kommer att röra vid sidan. Hovra över ett verktyg i Pencil-paletten för att se dess namn."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli aracın ucunu Apple Pencil’ın sayfaya dokunacağı yerde gösterir. Adını görmek için Pencil paletindeki bir aracın üzerine gelin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Apple Pencil 将要触及页面的位置显示当前工具的笔尖。悬停在 Pencil 调板中的工具上即可查看其名称。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 Apple Pencil 將要觸及頁面的位置顯示目前工具的筆尖。懸停在 Pencil 工具盤中的工具上即可查看其名稱。"
          }
        }
      }
    },
