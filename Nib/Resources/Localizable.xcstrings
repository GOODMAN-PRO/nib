    "Your copy is locked, so you left the live session." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Kopie ist gesperrt, daher hast du die Live-Sitzung verlassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu copia está bloqueada, así que has salido de la sesión en directo."
          }
        },
        "fr" : {
          "stringUnit" : {
