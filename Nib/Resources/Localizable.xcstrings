    "%@ opens locked documents without typing, on this %@ only. Removing a lock always asks for the password." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ öffnet gesperrte Dokumente ohne Eingabe, nur auf diesem %@. Zum Entfernen einer Sperre wird immer das Passwort abgefragt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ abre documentos bloqueados sin escribir, solo en este %@. Quitar un bloqueo siempre pide la contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ouvre les documents verrouillés sans saisie, sur cet %@ uniquement. La suppression d’un verrouillage demande toujours le mot de passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ apre i documenti bloccati senza digitare, solo su questo %@. La rimozione di un blocco chiede sempre la password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@では、この%@でのみ入力せずにロックされた書類を開けます。ロックを解除するときは常にパスワードが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@(으)로 이 %@에서만 입력 없이 잠긴 문서를 열 수 있습니다. 잠금을 제거할 때는 항상 암호를 요청합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ opent vergrendelde documenten zonder typen, alleen op deze %@. Voor het verwijderen van een vergrendeling wordt altijd om het wachtwoord gevraagd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ otwiera zablokowane dokumenty bez wpisywania, tylko na tym urządzeniu (%@). Usunięcie blokady zawsze wymaga hasła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ abre documentos bloqueados sem digitar, apenas neste %@. Remover um bloqueio sempre pede a senha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ открывает заблокированные документы без ввода, только на этом устройстве (%@). Для снятия блокировки всегда нужен пароль."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ öppnar låsta dokument utan att du skriver, endast på den här %@. Att ta bort ett lås kräver alltid lösenordet."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, kilitli belgeleri yalnızca bu %@ aygıtında yazmadan açar. Bir kilidi kaldırmak her zaman parola ister."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@无需键入即可打开已锁定的文稿，仅限此%@。移除锁定时始终需要输入密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@不需輸入即可打開已鎖定的文件，僅限此%@。移除鎖定時一律需要輸入密碼。"
          }
        }
      }
    },
