    "Microphone access is off for Nib. Turn it on in Settings to record." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mikrofonzugriff ist für Nib deaktiviert. Aktiviere ihn in den Einstellungen, um aufzunehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso al micrófono está desactivado para Nib. Actívalo en Ajustes para grabar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès au micro est désactivé pour Nib. Activez-le dans Réglages pour enregistrer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso al microfono è disattivato per Nib. Attivalo in Impostazioni per registrare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nibのマイクへのアクセスがオフになっています。録音するには「設定」でオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nib의 마이크 접근이 꺼져 있습니다. 녹음하려면 설정에서 켜십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microfoontoegang staat uit voor Nib. Zet deze aan in Instellingen om op te nemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostęp do mikrofonu jest wyłączony dla Nib. Włącz go w Ustawieniach, aby nagrywać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso ao microfone está desativado para o Nib. Ative-o em Ajustes para gravar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к микрофону для Nib выключен. Включите его в Настройках, чтобы записывать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonåtkomst är avstängd för Nib. Slå på den i Inställningar för att spela in."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nib için mikrofon erişimi kapalı. Kayıt yapmak için Ayarlar’da açın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
