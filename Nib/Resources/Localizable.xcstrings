    "Allow Nib full access to Calendars in Settings to see your events and take notes for them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Nib in den Einstellungen vollen Zugriff auf Kalender, um deine Ereignisse zu sehen und Notizen dazu zu machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite a Nib el acceso total a Calendarios en Ajustes para ver tus eventos y tomar notas para ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez l’accès complet de Nib à Calendrier dans Réglages pour voir vos évènements et prendre des notes pour eux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti a Nib l’accesso completo a Calendario in Impostazioni per vedere i tuoi eventi e prendere appunti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イベントを表示してメモを取るには、「設定」でNibにカレンダーへのフルアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이벤트를 보고 메모를 작성하려면 설정에서 Nib에 캘린더 전체 접근을 허용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geef Nib in Instellingen volledige toegang tot Agenda om je gebeurtenissen te zien en er notities voor te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól Nib na pełny dostęp do Kalendarza w Ustawieniach, aby widzieć wydarzenia i robić do nich notatki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita que o Nib tenha acesso total ao Calendário em Ajustes para ver seus eventos e fazer notas para eles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите Nib полный доступ к Календарю в Настройках, чтобы видеть события и делать к ним заметки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ge Nib full åtkomst till Kalender i Inställningar för att se dina händelser och anteckna för dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinliklerinizi görmek ve onlar için not almak üzere Ayarlar’da Nib’e Takvimler’e tam erişim izni verin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置”中允许 Nib 完全访问日历，以查看你的事件并为其记笔记。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「設定」中允許 Nib 完整取用行事曆，以查看你的行程並為其記筆記。"
          }
        }
      }
    },
