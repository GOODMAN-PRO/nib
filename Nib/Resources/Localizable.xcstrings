    "Tap an image, shape or text box with any tool to select it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe mit einem beliebigen Werkzeug auf ein Bild, eine Form oder ein Textfeld, um es auszuwählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una imagen, forma o cuadro de texto con cualquier herramienta para seleccionarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une image, une forme ou une zone de texte avec n’importe quel outil pour la sélectionner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un’immagine, una forma o un riquadro di testo con qualsiasi strumento per selezionarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意のツールで画像、図形、テキストボックスをタップすると選択できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무 도구로나 이미지, 도형 또는 텍스트 상자를 탭하여 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik met elk gereedschap op een afbeelding, vorm of tekstvak om deze te selecteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij obraz, kształt lub pole tekstowe dowolnym narzędziem, aby je zaznaczyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em uma imagem, forma ou caixa de texto com qualquer ferramenta para selecioná-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь изображения, фигуры или текстового поля любым инструментом, чтобы выбрать его."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på en bild, form eller textruta med valfritt verktyg för att markera den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçmek için herhangi bir araçla bir görüntüye, şekle veya metin kutusuna dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用任意工具轻点图像、形状或文本框即可将其选中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用任何工具點一下影像、形狀或文字框即可將其選取。"
          }
        }
      }
    },
    "Tap an image, shape, text box or sticky note with your finger to select it. Turn this off to scroll past objects without selecting them." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe mit dem Finger auf ein Bild, eine Form, ein Textfeld oder eine Haftnotiz, um es auszuwählen. Deaktiviere dies, um an Objekten vorbeizuscrollen, ohne sie auszuwählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una imagen, forma, cuadro de texto o nota adhesiva con el dedo para seleccionarla. Desactívalo para desplazarte por los objetos sin seleccionarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une image, une forme, une zone de texte ou une note adhésive avec le doigt pour la sélectionner. Désactivez cette option pour faire défiler les objets sans les sélectionner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un’immagine, una forma, un riquadro di testo o una nota adesiva con il dito per selezionarlo. Disattiva questa opzione per scorrere oltre gli oggetti senza selezionarli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像、図形、テキストボックス、付箋を指でタップすると選択できます。オフにすると、選択せずにオブジェクトの上をスクロールできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손가락으로 이미지, 도형, 텍스트 상자 또는 스티커 메모를 탭하여 선택하십시오. 끄면 선택하지 않고 객체 위로 스크롤할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik met je vinger op een afbeelding, vorm, tekstvak of plaknotitie om die te selecteren. Zet dit uit om langs objecten te scrollen zonder ze te selecteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij palcem obraz, kształt, pole tekstowe lub karteczkę, aby je zaznaczyć. Wyłącz, aby przewijać obok obiektów bez ich zaznaczania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em uma imagem, forma, caixa de texto ou nota adesiva com o dedo para selecioná-la. Desative para rolar pelos objetos sem selecioná-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь пальцем изображения, фигуры, текстового поля или стикера, чтобы выбрать его. Выключите, чтобы прокручивать мимо объектов, не выбирая их."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på en bild, form, textruta eller klisterlapp med fingret för att markera den. Stäng av detta för att rulla förbi objekt utan att markera dem."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçmek için bir görüntüye, şekle, metin kutusuna veya yapışkan nota parmağınızla dokunun. Nesneleri seçmeden kaydırmak için bunu kapatın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用手指轻点图像、形状、文本框或便笺即可将其选中。关闭后，可以滚动经过对象而不选中它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用手指點一下影像、形狀、文字框或便利貼即可將其選取。關閉後，可以捲動經過物件而不選取它們。"
          }
        }
      }
    },
