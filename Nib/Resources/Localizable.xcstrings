    "Recording stopped because the audio could not be saved. Free up some space and try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufnahme wurde gestoppt, weil das Audio nicht gesichert werden konnte. Gib etwas Speicherplatz frei und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación se ha detenido porque el audio no se ha podido guardar. Libera espacio e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement s’est arrêté car l’audio n’a pas pu être enregistré. Libérez de l’espace et réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione si è interrotta perché non è stato possibile salvare l’audio. Libera spazio e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディオを保存できなかったため、録音が停止しました。空き領域を増やしてもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오디오를 저장할 수 없어 녹음이 중단되었습니다. 저장 공간을 확보한 다음 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De opname is gestopt omdat de audio niet kon worden bewaard. Maak wat ruimte vrij en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nagrywanie zostało zatrzymane, ponieważ nie udało się zachować dźwięku. Zwolnij trochę miejsca i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação parou porque o áudio não pôde ser salvo. Libere espaço e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись остановлена, так как не удалось сохранить аудио. Освободите место и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspelningen stoppades eftersom ljudet inte kunde sparas. Frigör lite utrymme och försök igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses kaydedilemediği için kayıt durdu. Biraz yer açın ve yeniden deneyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于无法存储音频，录音已停止。请释放一些空间并重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因為無法儲存音訊，錄音已停止。請釋放一些空間並再試一次。"
          }
        }
      }
    },
