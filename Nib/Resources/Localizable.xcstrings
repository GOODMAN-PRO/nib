    "People without Nib can't open a live session. To share with them, export a PDF." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personen ohne Nib können keine Live-Sitzung öffnen. Um mit ihnen zu teilen, exportiere ein PDF."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las personas sin Nib no pueden abrir una sesión en directo. Para compartir con ellas, exporta un PDF."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les personnes sans Nib ne peuvent pas ouvrir de session en direct. Pour partager avec elles, exportez un PDF."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le persone senza Nib non possono aprire una sessione dal vivo. Per condividere con loro, esporta un PDF."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nibを持っていない人はライブセッションを開けません。共有するにはPDFを書き出してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nib이 없는 사람은 라이브 세션을 열 수 없습니다. 그들과 공유하려면 PDF를 내보내십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensen zonder Nib kunnen geen livesessie openen. Exporteer een pdf om met hen te delen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Osoby bez Nib nie mogą otworzyć sesji na żywo. Aby im udostępnić, wyeksportuj PDF."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pessoas sem o Nib não podem abrir uma sessão ao vivo. Para compartilhar com elas, exporte um PDF."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Люди без Nib не могут открыть совместный сеанс. Чтобы поделиться с ними, экспортируйте PDF."
          }
        },
        "sv" : {
          "stringUnit" : {
