          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasso jest zawsze pierwsze. Ukryte narzędzia są dostępne jednym stuknięciem w sekcji Więcej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
