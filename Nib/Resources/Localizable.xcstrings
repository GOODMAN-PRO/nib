    "Hidden layers stay hidden on this device only and are left out when you export." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgeblendete Ebenen bleiben nur auf diesem Gerät ausgeblendet und werden beim Exportieren weggelassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capas ocultas solo se ocultan en este dispositivo y se omiten al exportar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les calques masqués ne le sont que sur cet appareil et sont exclus lors de l’exportation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I livelli nascosti restano nascosti solo su questo dispositivo e vengono esclusi dall’esportazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非表示のレイヤーはこのデバイスでのみ非表示になり、書き出し時には除外されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "숨겨진 레이어는 이 기기에서만 숨겨지며 내보낼 때 제외됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verborgen lagen blijven alleen op dit apparaat verborgen en worden weggelaten bij het exporteren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukryte warstwy pozostają ukryte tylko na tym urządzeniu i są pomijane przy eksporcie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
