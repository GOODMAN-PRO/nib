    "Double-tap the page with two fingers to undo and with three fingers to redo." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe mit zwei Fingern zweimal auf die Seite, um zu widerrufen, und mit drei Fingern, um zu wiederholen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces la página con dos dedos para deshacer y con tres dedos para rehacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez deux fois la page avec deux doigts pour annuler et avec trois doigts pour rétablir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca due volte la pagina con due dita per annullare e con tre dita per ripristinare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2本指でページをダブルタップすると取り消し、3本指でダブルタップするとやり直します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "두 손가락으로 페이지를 이중 탭하면 실행 취소하고, 세 손가락으로 이중 탭하면 실행 복귀합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik twee keer met twee vingers op de pagina om ongedaan te maken en met drie vingers om opnieuw uit te voeren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij dwukrotnie stronę dwoma palcami, aby cofnąć, i trzema palcami, aby przywrócić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes na página com dois dedos para desfazer e com três dedos para refazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дважды коснитесь страницы двумя пальцами, чтобы отменить, и тремя пальцами, чтобы повторить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck två gånger på sidan med två fingrar för att ångra och med tre fingrar för att göra om."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geri almak için sayfaya iki parmakla, yinelemek için üç parmakla çift dokunun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用两指连按页面两次以撤销，用三指连按两次以重做。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用兩指在頁面上點兩下以還原，用三指點兩下以重做。"
