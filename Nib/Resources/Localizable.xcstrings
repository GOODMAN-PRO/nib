    "The copy holds your notes. Share it only with someone you trust, and delete it in Files when you're done." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopie enthält deine Notizen. Teile sie nur mit jemandem, dem du vertraust, und lösche sie in „Dateien“, wenn du fertig bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia contiene tus notas. Compártela solo con alguien de confianza y elimínala en Archivos cuando termines."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie contient vos notes. Ne la partagez qu’avec une personne de confiance, et supprimez-la dans Fichiers une fois terminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia contiene le tue note. Condividila solo con qualcuno di cui ti fidi ed eliminala in File quando hai finito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コピーにはノートが含まれます。信頼できる相手とのみ共有し、終わったら「ファイル」で削除してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사본에는 노트가 들어 있습니다. 신뢰하는 사람과만 공유하고, 완료되면 파일 앱에서 삭제하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kopie bevat je notities. Deel deze alleen met iemand die je vertrouwt en verwijder hem in Bestanden als je klaar bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopia zawiera Twoje notatki. Udostępniaj ją tylko zaufanym osobom i usuń ją w aplikacji Pliki, gdy skończysz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cópia contém suas notas. Compartilhe-a apenas com alguém de confiança e apague-a em Arquivos quando terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копия содержит ваши заметки. Делитесь ею только с теми, кому доверяете, и удалите ее в «Файлах», когда закончите."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopian innehåller dina anteckningar. Dela den bara med någon du litar på och radera den i Filer när du är klar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopya notlarınızı içerir. Yalnızca güvendiğiniz biriyle paylaşın ve işiniz bitince Dosyalar’dan silin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "副本包含你的笔记。请仅与你信任的人共享，完成后在“文件”中将其删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "副本包含你的筆記。請只與你信任的人分享，完成後在「檔案」中將其刪除。"
          }
        }
      }
    },
