          "stringUnit" : {
            "state" : "translated",
            "value" : "Los títulos no pueden contener / ni :."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les titres ne peuvent pas contenir / ni :."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I titoli non possono contenere / o :."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイトルに / や : は使用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제목에 / 또는 :을 포함할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titels mogen geen / of : bevatten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tytuły nie mogą zawierać znaków / ani :."
          }
        },
