    "Its pages are added after the last page of the notebook you choose, and the QuickNote moves to Trash." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Seiten werden nach der letzten Seite des gewählten Notizbuchs hinzugefügt, und die QuickNote wird in den Papierkorb gelegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus páginas se añaden después de la última página del cuaderno que elijas y la QuickNote se mueve a la papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses pages sont ajoutées après la dernière page du carnet choisi, et la QuickNote est placée dans la corbeille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sue pagine vengono aggiunte dopo l’ultima pagina del quaderno che scegli e la QuickNote viene spostata nel Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ページは選択したノートの最後のページの後に追加され、QuickNoteはゴミ箱に移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 노트의 마지막 페이지 뒤에 페이지가 추가되고, QuickNote는 휴지통으로 이동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De pagina's worden toegevoegd na de laatste pagina van het notitieboek dat je kiest, en de QuickNote gaat naar de prullenmand."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jej strony zostaną dodane po ostatniej stronie wybranego notatnika, a QuickNote zostanie przeniesiona do kosza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As páginas são adicionadas após a última página do caderno que você escolher, e a QuickNote vai para a Lixeira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ее страницы будут добавлены после последней страницы выбранного блокнота, а QuickNote будет перемещена в Корзину."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dess sidor läggs till efter sista sidan i anteckningsboken du väljer, och QuickNote flyttas till papperskorgen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sayfaları seçtiğiniz defterin son sayfasından sonra eklenir ve QuickNote Çöp Kutusu’na taşınır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其页面会添加到你所选笔记本的最后一页之后，QuickNote 会移到废纸篓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其頁面會加入你所選筆記本的最後一頁之後，QuickNote 會移到垃圾桶。"
          }
        }
      }
    },
