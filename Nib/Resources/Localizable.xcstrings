          "stringUnit" : {
            "state" : "translated",
            "value" : "全ページタイピング。入力を終了するには「完了」をダブルタップするか、Escキーを押してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 페이지 타이핑. 타이핑을 중단하려면 완료를 두 번 탭하거나 Esc 키를 누르십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typen op volledige pagina. Tik twee keer op 'Gereed' of druk op Escape om te stoppen met typen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pisanie na całej stronie. Stuknij dwukrotnie Gotowe lub naciśnij Escape, aby przestać pisać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digitação em página inteira. Toque duas vezes em OK ou pressione Esc para parar de digitar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Набор текста на всю страницу. Дважды коснитесь «Готово» или нажмите Escape, чтобы закончить ввод."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrivande på hela sidan. Tryck två gånger på Klar eller tryck på Escape för att sluta skriva."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tam sayfa yazma. Yazmayı bitirmek için Bitti’ye iki kez dokunun veya Esc tuşuna basın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整页键入。连按两次“完成”或按下 Esc 键即可停止键入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整頁輸入。點兩下「完成」或按下 Esc 鍵即可停止輸入。"
          }
        }
      }
    },
