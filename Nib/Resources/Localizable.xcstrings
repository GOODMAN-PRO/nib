    "Every notebook is a file in your library folder, so it stays safe when Nib is reinstalled." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Notizbuch ist eine Datei in deinem Bibliotheksordner und bleibt daher erhalten, wenn Nib neu installiert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada cuaderno es un archivo en la carpeta de tu biblioteca, así que está a salvo si reinstalas Nib."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque carnet est un fichier dans le dossier de votre bibliothèque : il reste en sécurité si vous réinstallez Nib."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
