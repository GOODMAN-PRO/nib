    "Reduce Motion is on, so the water already moves without stretching." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Bewegung reduzieren“ ist aktiviert, daher bewegt sich das Wasser bereits ohne Dehnung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reducir movimiento está activado, así que el agua ya se mueve sin estirarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduire les animations est activé : l’eau se déplace donc déjà sans s’étirer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
