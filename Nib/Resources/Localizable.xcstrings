    "Double-tap for ruler options. Swipe up or down to rotate." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe zweimal für Linealoptionen. Streiche nach oben oder unten, um es zu drehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces para ver las opciones de la regla. Desliza hacia arriba o hacia abajo para girarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez deux fois pour les options de la règle. Balayez vers le haut ou le bas pour la faire pivoter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca due volte per le opzioni del righello. Scorri in alto o in basso per ruotarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダブルタップすると定規のオプションが表示されます。上下にスワイプすると回転します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자 옵션을 보려면 이중 탭하십시오. 회전하려면 위 또는 아래로 쓸어넘기십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik twee keer voor liniaalopties. Veeg omhoog of omlaag om te draaien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij dwukrotnie, aby zobaczyć opcje linijki. Przesuń palcem w górę lub w dół, aby ją obrócić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes para ver as opções da régua. Deslize para cima ou para baixo para girar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дважды коснитесь, чтобы открыть параметры линейки. Смахните вверх или вниз, чтобы повернуть ее."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck två gånger för linjalalternativ. Svep uppåt eller nedåt för att rotera."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cetvel seçenekleri için çift dokunun. Döndürmek için yukarı veya aşağı kaydırın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连按两次以查看标尺选项。向上或向下轻扫以旋转。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點兩下以查看尺規選項。向上或向下滑動以旋轉。"
          }
        }
      }
    },
