    "The server rejected the password. Automatic sync is paused until you re-enter it below." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat das Passwort abgelehnt. Die automatische Synchronisierung ist pausiert, bis du es unten erneut eingibst."
